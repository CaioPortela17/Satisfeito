# Copie este arquivo para .env.local e preencha com os valores do painel do Supabase
# (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (Project Settings > API Keys). Só no servidor: nunca use NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=

# Segredo do carimbo de tempo da pesquisa pública. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CARIMBO_SEGREDO=

# Endereço público do site (usado nos links dos e-mails). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (anti-robô). Crie o widget em dash.cloudflare.com > Turnstile (modo Managed).
# Em desenvolvimento use as chaves de teste da Cloudflare (sempre passam):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Só no servidor: nunca use NEXT_PUBLIC_ nesta.
TURNSTILE_SECRET_KEY=
