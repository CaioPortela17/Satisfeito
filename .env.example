# Copie este arquivo para .env.local e preencha com os valores do painel do Supabase
# (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (Project Settings > API Keys). Só no servidor: nunca use NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=

# Segredo do carimbo de tempo da pesquisa pública. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CARIMBO_SEGREDO=

# Endereço público do site (usado nos links dos e-mails). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (anti-robô). Crie o widget em dash.cloudflare.com > Turnstile (modo Managed).
# Em desenvolvimento use as chaves de teste da Cloudflare (sempre passam):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE=
# Só no servidor: nunca use NEXT_PUBLIC_ nesta.
TURNSTILE_SECRET_KEY=

# Resumo por IA (Etapa 7). Chave em console.anthropic.com > API Keys (precisa de crédito).
# Só no servidor: nunca use NEXT_PUBLIC_ nesta.
ANTHROPIC_API_KEY=

# Avisos por e-mail (nota baixa, rajada suspeita). Conta grátis em resend.com; o domínio do remetente precisa estar
# verificado lá. Sem estas duas variáveis o envio fica desligado e nada quebra. Só no servidor.
RESEND_API_KEY=
# Ex.: satisfeito <avisos@seudominio.com.br>
EMAIL_REMETENTE=
